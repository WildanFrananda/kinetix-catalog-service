# Kinetix Catalog Service — environment template
#
# Copy to .env and fill every value in. There are no defaults: the service refuses to
# start when SECRET_KEY or DB_PASSWORD is missing.
#
# Generate a secret with:  head -c 48 /dev/urandom | base64
# Never commit the filled-in .env, and never reuse a value across services.

PORT=8000

# DEBUG defaults to False. Only set it True for local work — it exposes tracebacks,
# settings and SQL to the client.
DEBUG=False

# Django signing key. Minimum 32 characters, enforced at boot.
SECRET_KEY=

# Comma-separated hostnames this service answers for. Required whenever DEBUG is off;
# "*" is not an acceptable value because it enables Host-header poisoning.
ALLOWED_HOSTS=

# Database. The application reads these names — DATABASE_URL is not used.
DB_HOST=localhost
DB_PORT=5434
DB_USER=kinetix_catalog_app
DB_NAME=kinetix_catalog_dev
DB_PASSWORD=

# Every one of these is read with `required_env` or its equivalent, which refuses a default on
# purpose. This template used to list PRICING_GRPC_URL — which nothing read — and none of the four
# below, so a developer who copied it got a service that would not boot and a dependency that did
# not exist. (docs/BOUNDARY-DEBT.md, Bagian 7)
WAREHOUSE_GRPC_URL=localhost:50051
IDENTITY_GRPC_URL=localhost:50052

# Identity's published signing keys, and the two claims every token here is checked against. Read
# locally per boot; never asked about per request, and never taken from a header.
IDENTITY_JWKS_URL=http://localhost:5000/.well-known/jwks.json
JWT_ISSUER=https://identity.kinetix.local
JWT_AUDIENCE=kinetix

# Where this service's own mesh certificate is mounted. Defaults to /pki, which is right inside the
# container and wrong on a laptop; set it for a local run. Issue one with
# kinetix-infrastructure/bin/kinetix-pki issue.
KINETIX_PKI_DIR=

# What kinetix_build_info reports on GET /metrics. The image bakes this from the
# SERVICE_VERSION build argument; set it here to override for a local run. Unset falls back to
# the version this repository declares in ./VERSION, the way every other service in the estate
# reports the version its own manifest declares.
KINETIX_SERVICE_VERSION=

# PROMETHEUS_MULTIPROC_DIR is deliberately not here: gunicorn.conf.py sets it before it forks
# the workers, because it has to be set before prometheus_client is first imported.
